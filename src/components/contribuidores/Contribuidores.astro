---
// import './contribuidores.css' // Removed
---

<section
    class="py-20 bg-slate-900 relative overflow-hidden"
    id="contribuidores"
>
    <!-- Background Pattern -->
    <div
        class="absolute inset-0 opacity-5 bg-[radial-gradient(#14b8a6_1px,transparent_1px)] [background-size:16px_16px]"
    >
    </div>

    <div class="container mx-auto px-4 relative z-10">
        <div class="text-center mb-16 contrib-header">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                Nuestros Contribuidores
            </h2>
            <div class="w-20 h-1 bg-teal-500 mx-auto rounded-full"></div>
        </div>

        <div
            class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 gap-8 max-w-4xl mx-auto"
        >
            <!-- Contributor 1 -->
            <div class="group relative contrib-card opacity-0 translate-y-10">
                <div
                    class="absolute inset-0 bg-teal-500 rounded-2xl blur opacity-20 group-hover:opacity-40 transition-opacity duration-300"
                >
                </div>
                <div
                    class="relative bg-slate-800 p-4 rounded-2xl border border-white/5 hover:border-teal-500/30 transition-colors"
                >
                    <div class="aspect-square overflow-hidden rounded-xl mb-4">
                        <img
                            src="/socios/angel.png"
                            alt="Angel Saucedo"
                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                        />
                    </div>
                    <h3 class="text-xl font-semibold text-white text-center">
                        Angel Saucedo
                    </h3>
                    <p class="text-teal-400 text-center text-sm">
                        Full Stack Developer
                    </p>
                </div>
            </div>

            <!-- Contributor 2 -->
            <div class="group relative contrib-card opacity-0 translate-y-10">
                <div
                    class="absolute inset-0 bg-teal-500 rounded-2xl blur opacity-20 group-hover:opacity-40 transition-opacity duration-300"
                >
                </div>
                <div
                    class="relative bg-slate-800 p-4 rounded-2xl border border-white/5 hover:border-teal-500/30 transition-colors"
                >
                    <div class="aspect-square overflow-hidden rounded-xl mb-4">
                        <img
                            src="/socios/jorge.png"
                            alt="Jorge Cañete"
                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                        />
                    </div>
                    <h3 class="text-xl font-semibold text-white text-center">
                        Jorge Cañete
                    </h3>
                    <p class="text-teal-400 text-center text-sm">
                        Full Stack Developer
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    gsap.from(".contrib-header", {
        scrollTrigger: {
            trigger: "#contribuidores",
            start: "top 80%",
        },
        y: 30,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out",
    });

    gsap.to(".contrib-card", {
        scrollTrigger: {
            trigger: "#contribuidores",
            start: "top 70%",
        },
        y: 0,
        opacity: 1,
        duration: 0.8,
        stagger: 0.2,
        ease: "power2.out",
    });
</script>
